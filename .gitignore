# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
venv/
.venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Node
node_modules/
dist/
build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# Python cache/testing
.pytest_cache/
.mypy_cache/
# Data files (large, not code, and OSHA/public data shouldn't live in git history)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep